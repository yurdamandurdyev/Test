# Generate long random values; never commit .env or paste secrets into chat.
APP_PASSWORD=
SESSION_SECRET=
# false ONLY for local HTTP; production default is true
COOKIE_SECURE=true
# Optional private annotations JSON, stored OUTSIDE the public checkout:
CALLS_ANNOTATIONS_PATH=
# Alternative for Vercel: private JSON in SERVER environment only, never VITE_*
# Use dashboard secure environment entry; leave empty in public demo.
CALLS_ANNOTATIONS_JSON=
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram User IDs; private chats only
TELEGRAM_ALLOWED_USER_IDS=
